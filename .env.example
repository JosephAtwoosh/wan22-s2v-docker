# Copy to .env and edit. Never commit a real key.
#
# ------------------------------------------------------------------- renders
# Render area preset: 720p (1280*720 area), 704p (1024*704), 480p (832*480).
# The output width/height follow the start image's aspect ratio and are padded
# to Wan's 64-pixel grid, so a 16:9 still renders 1280x704 at 720p.
SIZE=720p

# Frames per clip. 80 = 5 s at the model's native 16 fps; must be a multiple
# of 4. Longer audio just means more clips, rendered in one process.
INFER_FRAMES=80

# Use the still as frame 0. On by default: the shot's first frame is the still,
# and it also avoids losing the last three frames of a clip.
START_FROM_REF=1

# Sampling: 40 steps / 4.5 guidance / shift 3.0 are the model's own defaults.
# Raising steps costs time linearly; guidance above ~6 starts to over-act.
SAMPLE_STEPS=40
GUIDE_SCALE=4.5
SHIFT=3.0

# Offload the DiT to CPU between forwards. Required on less than 80 GB; slower.
OFFLOAD_MODEL=1

# -1 = pick a random seed and record it in the manifest.
SEED=-1

# Retime the 16 fps clip to 24 fps by duplicating frames (0 = leave at 16).
# Set this if the edit is a 24 fps timeline; it does not change sync.
CONFORM_FPS=0

# Abort a render that runs longer than this (seconds). 4 hours.
RENDER_TIMEOUT_S=14400

# GPUs. 1 = single card with offload. >1 uses torchrun + FSDP + Ulysses.
GPUS=1

# -------------------------------------------------------------------- service
# Bearer token for the HTTP API. Leave empty ONLY on a private network: Vast
# maps the port to the internet, so set this before renting.
WAN_API_KEY=change-me-before-you-rent

HOST=0.0.0.0
PORT=8000
ENGINE=wan
MODEL_ID=/models/Wan2.2-S2V-14B
OUTPUT_DIR=/output
PERFORMANCES_DIR=/performances

# Upload limits.
MAX_UPLOAD_MB=200
MAX_AUDIO_SECONDS=300
MAX_PROMPT_CHARS=4000

# Host folders (compose maps them to /models, /performances, /output).
MODELS_HOST_DIR=./models
PERFORMANCES_HOST_DIR=./performances
OUTPUT_HOST_DIR=./output

# ---------------------------------------------------------------------- image
# Optional: a Read token, only if Hugging Face rate-limits anonymous download.
HF_TOKEN=
HF_MAX_WORKERS=8

# Tag used by compose when building instead of pulling GHCR.
WAN22_IMAGE=ghcr.io/josephatwoosh/wan22-s2v-docker:latest
